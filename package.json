{
  "name": "el-j-github-io",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch-i18n": "node scripts/fetch-i18n.mjs",
    "fetch-projects": "tsx scripts/fetch-projects.mjs",
    "prebuild": "npm run fetch-i18n && npm run fetch-projects",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@primevue/themes": "^4.3.3",
    "@vueuse/core": "^13.0.0",
    "pinia": "^3.0.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@el-j/google-sheet-translations": "^1.3.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.0.14",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.8.3",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^6.2.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.8"
  }
}

---
import WorkstationLayout from '@/layouts/WorkstationLayout.astro';
import LatestDeployment from '@/components/workstation/LatestDeployment.astro';
import SynthGroovebox from '@/components/workstation/SynthGroovebox.astro';
import LiveTerminal from '@/components/workstation/LiveTerminal.astro';
import TokenAstVisualizer from '@/components/workstation/TokenAstVisualizer.astro';
---

<WorkstationLayout activeTab="about">
  <!-- 2x2 Workstation Matrix (Exactly mirroring the concept moodboard) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 sm:gap-4">
    <!-- Top Left: Latest Deployment & Git Graph -->
    <div class="lg:col-span-5">
      <LatestDeployment />
    </div>

    <!-- Top Right: + SYNTH_T1 + Pocket Synthesizer -->
    <div class="lg:col-span-7">
      <SynthGroovebox />
    </div>

    <!-- Bottom Left: CLI / DEBUG_ENV Live Terminal REPL -->
    <div class="lg:col-span-6">
      <LiveTerminal />
    </div>

    <!-- Bottom Right: token specs -> AST Interactive Visualizer -->
    <div class="lg:col-span-6">
      <TokenAstVisualizer />
    </div>
  </div>

  <!-- Deep Bio / Philosophy Drawer -->
  <div class="mt-4 pt-3 border-t border-[var(--crt-border-dim)] text-xs font-mono grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="border border-[var(--crt-border-dim)] p-2.5 bg-black/30 rounded">
      <div class="text-[var(--crt-phosphor-bright)] font-bold mb-1 flex items-center gap-1.5">
        <span>[01]</span>
        <span>THE DUAL-MINDED CRAFT</span>
      </div>
      <p class="text-[var(--crt-phosphor)] text-[11px] leading-relaxed opacity-90 m-0">
        Bridging high-craft UI design with low-level fullstack systems engineering. I don't build generic SaaS templates; I design tactile interfaces, design token pipelines, and resilient compilers.
      </p>
    </div>

    <div class="border border-[var(--crt-border-dim)] p-2.5 bg-black/30 rounded">
      <div class="text-[var(--crt-phosphor-bright)] font-bold mb-1 flex items-center gap-1.5">
        <span>[02]</span>
        <span>ZERO-JS BASELINE</span>
      </div>
      <p class="text-[var(--crt-phosphor)] text-[11px] leading-relaxed opacity-90 m-0">
        Rebuilt this entire portfolio in Astro 5. Sub-50ms paint times, zero runtime JavaScript payload by default, with isolated islands for terminal REPL and Web Audio synthesis.
      </p>
    </div>

    <div class="border border-[var(--crt-border-dim)] p-2.5 bg-black/30 rounded">
      <div class="text-[var(--crt-phosphor-bright)] font-bold mb-1 flex items-center gap-1.5">
        <span>[03]</span>
        <span>LINUX & ERGONOMICS</span>
      </div>
      <p class="text-[var(--crt-phosphor)] text-[11px] leading-relaxed opacity-90 m-0">
        Living in the terminal: Neovim, Zsh, custom CLI tools, and tiling window managers. The keyboard is the primary input device, and developer ergonomics drive every architecture decision.
      </p>
    </div>
  </div>
</WorkstationLayout>

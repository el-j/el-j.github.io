---
import WorkstationLayout from '@/layouts/WorkstationLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<WorkstationLayout activeTab="projects" title="Projects & Case Studies // el-j">
  <div class="space-y-3 pb-8">
    <!-- Header banner with sticky navigation & page scroll controls -->
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#3f3f46] pb-1.5 sticky top-0 bg-black/95 z-10 py-1">
      <div>
        <h2 class="text-xs sm:text-sm font-bold uppercase m-0 flex items-center gap-2 text-[#fbbf24]">
          <span>[02_PROJECTS]</span>
          <span>CURATED CASE STUDIES &amp; ARCHITECTURE SCHEMATICS</span>
        </h2>
        <p class="text-[10px] sm:text-[11px] text-[#71717a] m-0">
          No generic repo dumps. Real architectural problem solving &amp; systems engineering.
        </p>
      </div>
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="text-[10px] text-[#71717a] font-mono">
          TOTAL_FILES: <strong class="text-[#fbbf24]">{projects.length}</strong>
        </div>
        <!-- Tactile Scroll Controls for Quick Page Exploring -->
        <div class="flex items-center gap-1 font-mono text-[10px]" role="toolbar" aria-label="Projects page navigation">
          <button
            type="button"
            data-scroll="up"
            class="px-2 py-0.5 bg-black border border-[#3f3f46] hover:bg-[#27272a] hover:border-[#fbbf24] text-[#fbbf24] cursor-pointer transition-none flex items-center gap-1 font-bold"
            title="Page Up (PgUp / F6)"
          >
            <span>▲</span>
            <span>PG UP</span>
          </button>
          <button
            type="button"
            data-scroll="down"
            class="px-2 py-0.5 bg-black border border-[#3f3f46] hover:bg-[#27272a] hover:border-[#fbbf24] text-[#fbbf24] cursor-pointer transition-none flex items-center gap-1 font-bold"
            title="Page Down (PgDn / F7)"
          >
            <span>▼</span>
            <span>PG DN</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Projects Grid (DOS Style Text Mode Boxes) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {projects.map((proj) => (
        <article class="terminal-card text-xs flex flex-col justify-between border border-[#3f3f46] hover:border-[#fbbf24] bg-black p-2.5">
          <div>
            <!-- Card Header -->
            <div class="flex items-center justify-between border-b border-[#27272a] pb-1 mb-1.5 text-[10px] font-mono">
              <span class="text-[#38bdf8] font-bold">
                [{proj.data.category.toUpperCase()}]
              </span>
              <span class="text-[#71717a]">
                YEAR: {proj.data.year} // ROLE: {proj.data.role}
              </span>
            </div>

            <!-- Title & Description -->
            <h3 class="text-xs sm:text-sm font-bold text-[#ffffff] mb-1">
              {proj.data.title}
            </h3>
            <p class="text-[11px] text-[#d4d4d8] leading-relaxed mb-2.5">
              {proj.data.description}
            </p>

            <!-- Highlights -->
            {proj.data.uxHighlight && (
              <div class="mb-1.5 p-1.5 bg-[#09090b] border border-[#27272a] text-[10px]">
                <strong class="text-[#fbbf24] block mb-0.5">&gt; UX/UI CRAFT:</strong>
                <span class="text-[#d4d4d8]">{proj.data.uxHighlight}</span>
              </div>
            )}

            {proj.data.architectureHighlight && (
              <div class="mb-1.5 p-1.5 bg-[#09090b] border border-[#27272a] text-[10px]">
                <strong class="text-[#22c55e] block mb-0.5">&gt; ARCHITECTURE:</strong>
                <span class="text-[#d4d4d8]">{proj.data.architectureHighlight}</span>
              </div>
            )}

            <!-- Metrics -->
            {proj.data.metrics && (
              <div class="grid grid-cols-3 gap-1 my-1.5 text-[9px] text-center font-mono">
                {Object.entries(proj.data.metrics).map(([k, v]) => (
                  <div class="p-1 bg-[#09090b] border border-[#27272a]">
                    <span class="block text-[#71717a] truncate">{k}</span>
                    <strong class="text-[#ffffff]">{v}</strong>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Footer Tech Stack & Links -->
          <div class="pt-2 border-t border-[#27272a] mt-2 font-mono">
            <div class="flex flex-wrap items-center gap-1 mb-2">
              {proj.data.stack.map((tech) => (
                <span class="text-[9px] px-1 py-0.2 bg-[#18181b] border border-[#27272a] text-[#71717a]">
                  {tech}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-between text-[10px]">
              <div class="flex items-center gap-3">
                {proj.data.demoUrl && (
                  <a
                    href={proj.data.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[#38bdf8] hover:underline font-bold flex items-center gap-1"
                  >
                    <span>[LIVE_DEMO]</span>
                    <span>&nearr;</span>
                  </a>
                )}
                {proj.data.githubUrl && (
                  <a
                    href={proj.data.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[#d4d4d8] hover:underline flex items-center gap-1"
                  >
                    <span>[SOURCE_CODE]</span>
                    <span>&nearr;</span>
                  </a>
                )}
              </div>
              <span class="text-[9px] text-[#22c55e] font-mono">[VERIFIED]</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom Buffer Strip & Return to Top -->
    <div class="border-t border-[#3f3f46] pt-2 pb-2 flex flex-wrap items-center justify-between gap-2 text-[10px] sm:text-[11px] font-mono text-[#71717a]">
      <span>END OF BUFFER // ALL {projects.length} CASE STUDIES LOADED</span>
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-scroll="up"
          class="px-2 py-0.5 bg-black border border-[#3f3f46] hover:bg-[#27272a] hover:border-[#fbbf24] text-[#fbbf24] cursor-pointer transition-none flex items-center gap-1 font-bold"
        >
          <span>▲</span>
          <span>PG UP</span>
        </button>
        <button
          type="button"
          data-scroll="top"
          class="px-2 py-0.5 bg-black border border-[#3f3f46] hover:bg-[#27272a] hover:border-[#fbbf24] text-[#fbbf24] cursor-pointer transition-none font-bold flex items-center gap-1"
        >
          <span>⤒</span>
          <span>RETURN TO TOP</span>
        </button>
      </div>
    </div>
  </div>
</WorkstationLayout>

---
// PersistentBottomCli.astro - Omnipresent Interactive DOS & Linux Command Line Interface
---

<div
  class="persistent-bottom-cli border-t border-[var(--crt-border-dim)] bg-black/80 px-2.5 sm:px-4 py-1.5 font-mono select-none"
  id="persistent-bottom-cli"
  aria-label="Workstation Bottom Command Line Interface"
>
  <!-- Top Row: Live Output & Fast Action -->
  <div class="flex items-center justify-between text-[10px] text-[var(--crt-phosphor-dim)] mb-1 gap-2">
    <div class="flex items-center gap-2 truncate">
      <span class="text-[var(--crt-phosphor-bright)] font-bold text-[10px] sm:text-[11px]">[CLI_TTY1]</span>
      <span id="bottom-cli-output" class="text-[var(--crt-phosphor)] text-[10px] sm:text-[11px] truncate">
        READY // Press [F5] or type 'refresh' to degauss & update view. Press [F1] for help.
      </span>
    </div>
    <div class="flex items-center gap-1.5 shrink-0">
      <!-- Scroll Indicator & Page Buttons -->
      <div class="hidden sm:flex items-center gap-1 bg-black/60 px-2 py-0.5 border border-[var(--crt-border-dim)] rounded text-[10px] text-[var(--crt-phosphor-dim)]" title="Buffer Scroll Position">
        <span>SCRL:</span>
        <span class="crt-scroll-percent-val text-[var(--crt-phosphor-bright)] font-bold min-w-[28px] text-right">0%</span>
      </div>
      <button
        type="button"
        id="btn-scroll-page-up"
        data-scroll="up"
        class="px-2 py-0.5 rounded text-[10px] font-bold border border-[var(--crt-border-dim)] text-[var(--crt-phosphor)] bg-black/60 hover:bg-[var(--crt-phosphor)]/20 hover:text-[var(--crt-phosphor-bright)] hover:border-[var(--crt-phosphor)] transition-all cursor-pointer font-mono flex items-center gap-1"
        title="Page Up (PgUp / F6)"
      >
        <span>▲</span>
        <span>PG UP</span>
      </button>
      <button
        type="button"
        id="btn-scroll-page-down"
        data-scroll="down"
        class="px-2 py-0.5 rounded text-[10px] font-bold border border-[var(--crt-border-dim)] text-[var(--crt-phosphor)] bg-black/60 hover:bg-[var(--crt-phosphor)]/20 hover:text-[var(--crt-phosphor-bright)] hover:border-[var(--crt-phosphor)] transition-all cursor-pointer font-mono flex items-center gap-1"
        title="Page Down (PgDn / F7)"
      >
        <span>▼</span>
        <span>PG DN</span>
      </button>
      <button
        type="button"
        id="btn-bottom-cli-refresh"
        class="px-2 py-0.5 rounded text-[10px] font-bold border border-[var(--crt-border-dim)] text-[var(--crt-phosphor-bright)] bg-black/60 hover:bg-[var(--crt-phosphor)]/20 hover:border-[var(--crt-phosphor)] transition-all cursor-pointer font-mono"
        title="Refresh Workstation CRT View (F5)"
      >
        [ REFRESH (F5) ]
      </button>
    </div>
  </div>

  <!-- Bottom Row: Prompt Input + DOS Function Key Toolbar -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-1.5">
    <!-- Active CLI Form -->
    <form id="bottom-cli-form" class="flex-1 flex items-center gap-2 bg-black px-2.5 py-1 border border-[#3f3f46] text-xs">
      <label for="bottom-cli-input" class="text-[#fbbf24] font-bold whitespace-nowrap cursor-pointer text-[11px] sm:text-xs">
        C:\DOS\ARCH&gt;
      </label>
      <input
        type="text"
        id="bottom-cli-input"
        class="flex-1 bg-transparent border-none outline-none text-[#ffffff] font-mono text-[11px] sm:text-xs p-0 m-0 focus:ring-0"
        autocomplete="off"
        spellcheck="false"
        placeholder="type 'help', 'refresh', 'reboot', 'ls', 'pgdn'..."
      />
      <button type="submit" class="hidden" tabindex="-1" aria-hidden="true"></button>
      <span class="inline-block w-1.5 h-3 bg-[#fbbf24] animate-pulse" aria-hidden="true"></span>
    </form>

    <!-- DOS Function Key Toolbar (F1..F10) -->
    <div class="flex items-center gap-1 text-[9px] sm:text-[10px] text-[#71717a] font-mono overflow-x-auto py-0.5 shrink-0" role="toolbar" aria-label="DOS Function Keys">
      <button type="button" class="fn-key-btn hover:text-[#fbbf24] cursor-pointer px-1.5 py-0.5 bg-black border border-[#3f3f46] transition-colors" data-cmd="help">
        <strong class="text-[#fbbf24]">F1</strong>:Help
      </button>
      <button type="button" class="fn-key-btn hover:text-[#fbbf24] cursor-pointer px-1.5 py-0.5 bg-black border border-[#3f3f46] transition-colors" data-cmd="projects">
        <strong class="text-[#fbbf24]">F2</strong>:Proj
      </button>
      <button type="button" class="fn-key-btn hover:text-[#fbbf24] cursor-pointer px-1.5 py-0.5 bg-black border border-[#3f3f46] transition-colors" data-cmd="cli-tools">
        <strong class="text-[#fbbf24]">F3</strong>:Cli
      </button>
      <button type="button" class="fn-key-btn hover:text-[#fbbf24] cursor-pointer px-1.5 py-0.5 bg-black border border-[#3f3f46] transition-colors" data-cmd="clear" title="Clear Buffer (F4)">
        <strong class="text-[#fbbf24]">F4</strong>:Cls
      </button>
      <button type="button" class="fn-key-btn hover:text-[#fbbf24] cursor-pointer px-1.5 py-0.5 bg-[#fbbf24]/20 border border-[#fbbf24] text-[#fbbf24] transition-colors" data-cmd="refresh">
        <strong class="text-[#fbbf24]">F5</strong>:Refresh
      </button>
      <button type="button" class="fn-key-btn hover:text-[#fbbf24] cursor-pointer px-1.5 py-0.5 bg-black border border-[#3f3f46] transition-colors" data-cmd="pgup" title="Page Up (PgUp / F6)">
        <strong class="text-[#fbbf24]">F6</strong>:PgUp
      </button>
      <button type="button" class="fn-key-btn hover:text-[#fbbf24] cursor-pointer px-1.5 py-0.5 bg-black border border-[#3f3f46] transition-colors" data-cmd="pgdn" title="Page Down (PgDn / F7)">
        <strong class="text-[#fbbf24]">F7</strong>:PgDn
      </button>
      <button type="button" class="fn-key-btn hover:text-[#fbbf24] cursor-pointer px-1.5 py-0.5 bg-black border border-[#3f3f46] transition-colors" data-cmd="sound">
        <strong class="text-[#fbbf24]">F8</strong>:Sound
      </button>
      <button type="button" class="fn-key-btn hover:text-[#fbbf24] cursor-pointer px-1.5 py-0.5 bg-black border border-[#3f3f46] transition-colors" data-cmd="reboot">
        <strong class="text-[#fbbf24]">F10</strong>:Reboot
      </button>
    </div>
  </div>
</div>

<script>
  import { navigate } from 'astro:transitions/client';

  function setupBottomCli() {
    const form = document.getElementById('bottom-cli-form') as HTMLFormElement | null;
    const input = document.getElementById('bottom-cli-input') as HTMLInputElement | null;
    const output = document.getElementById('bottom-cli-output');
    const refreshBtn = document.getElementById('btn-bottom-cli-refresh');
    const fnButtons = document.querySelectorAll('.fn-key-btn');

    if (!form || !input || !output) return;

    const history: string[] = [];
    let historyIdx = -1;

    function setOutput(msg: string, isError = false) {
      if (!output) return;
      output.textContent = msg;
      output.className = isError
        ? 'text-red-400 font-bold truncate text-[10px] sm:text-[11px]'
        : 'text-[var(--crt-phosphor-bright)] truncate text-[10px] sm:text-[11px]';
    }

    // Comprehensive CRT Screen Refresh
    function triggerScreenRefresh() {
      const viewport = document.querySelector('.crt-workstation-viewport') as HTMLElement | null;
      if (viewport) {
        viewport.classList.remove('crt-refreshing');
        void viewport.offsetWidth; // trigger reflow
        viewport.classList.add('crt-refreshing');
        setTimeout(() => viewport.classList.remove('crt-refreshing'), 320);
      }

      if ((window as any).__playClickSound) {
        (window as any).__playClickSound();
      }

      // Update date stamp if visible
      const dateEl = document.getElementById('bezel-date-stamp');
      if (dateEl) {
        const d = new Date();
        const dateStr = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' }).toUpperCase();
        const timeStr = d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
        dateEl.textContent = `${dateStr} ${timeStr}`;
        dateEl.setAttribute('datetime', d.toISOString());
      }

      // Dispatch global refresh event for any custom listeners
      window.dispatchEvent(new CustomEvent('crt:refresh', { detail: { timestamp: Date.now() } }));

      const timeNow = new Date().toLocaleTimeString();
      setOutput(`[OK] Screen refreshed at ${timeNow}. Cathode ray degaussed & all buffers synchronized.`);
    }

    (window as any).__refreshCrtScreen = triggerScreenRefresh;

    function execute(raw: string) {
      const trimmed = raw.trim();
      if (!trimmed) return;

      history.push(trimmed);
      historyIdx = history.length;

      const parts = trimmed.split(/\s+/);
      const cmd = parts[0].toLowerCase();
      const arg = parts.slice(1).join(' ').toLowerCase();

      switch (cmd) {
        case 'refresh':
        case 'cls':
        case 'clear':
          triggerScreenRefresh();
          break;

        case 'help':
        case '?':
          setOutput('CMDS: pgup, pgdn, top, bottom, refresh, reboot, theme <amber|green|ice|paper>, scanlines, sound, ls, cat <file>, goto <dir>');
          break;

        case 'reboot':
        case 'restart':
          setOutput('Initiating Hardware Reset POST...');
          if ((window as any).__triggerBiosBoot) {
            (window as any).__triggerBiosBoot();
          } else {
            sessionStorage.removeItem('crt-booted');
            window.location.reload();
          }
          break;

        case 'theme':
          setOutput('Display theme locked to Award BIOS VGA 80x25 text mode.');
          break;

        case 'scanlines': {
          const scanBtn = document.getElementById('btn-toggle-scanlines') as HTMLButtonElement | null;
          if (scanBtn) {
            scanBtn.click();
            const state = scanBtn.getAttribute('aria-checked') === 'true' ? 'ON' : 'OFF';
            setOutput(`Scanlines toggled [${state}].`);
          }
          break;
        }

        case 'sound': {
          const soundBtn = document.getElementById('btn-toggle-sound') as HTMLButtonElement | null;
          if (soundBtn) {
            soundBtn.click();
            const state = soundBtn.getAttribute('aria-checked') === 'true' ? 'ON' : 'OFF';
            setOutput(`Sound FX toggled [${state}].`);
          }
          break;
        }

        case 'ls':
        case 'dir':
          setOutput('A:\\> [1:ABOUT.SYS]  [2:PROJECTS.DIR]  [3:CLI_TOOLS.COM]  [SYNTH.BIN]');
          break;

        case 'cat':
        case 'type':
          if (arg.includes('about')) {
            setOutput('Fabian Althaus (el-j) // Fullstack UX/UI & Linux Engineer. 10+ yrs across design systems, compilers, & IoT.');
          } else if (arg.includes('proj')) {
            setOutput('RunZero (dual runners), @el-j/google-sheet-translations, E-Cube biotech, DomeDrum MIDI, Fritzing EDA.');
          } else if (arg.includes('synth')) {
            const synthBtn = document.getElementById('btn-toggle-synth') as HTMLButtonElement | null;
            if (synthBtn) synthBtn.click();
            setOutput('Engaging Pocket Synthesizer island...');
          } else {
            setOutput(`File [${arg || 'unknown'}] read: 100% OK. Use 'goto' or function keys to inspect.`);
          }
          break;

        case 'whoami':
          setOutput('fabian-althaus (uid=1000) // Fullstack UX/UI & Linux Engineer // el-j@station');
          break;

        case 'goto':
        case 'cd':
          if (arg.includes('proj') || arg === '2') {
            navigate('/projects');
          } else if (arg.includes('cli') || arg === '3') {
            navigate('/cli-tools');
          } else if (arg.includes('about') || arg === '1' || arg === '/' || arg === '~') {
            navigate('/');
          } else {
            setOutput(`Directory [${arg}] not found. Try: cd projects | cli-tools | ~`, true);
          }
          break;

        case 'projects':
          navigate('/projects');
          break;
        case 'cli-tools':
          navigate('/cli-tools');
          break;

        case 'pgup':
        case 'pageup':
        case 'page-up':
        case 'up':
          if ((window as any).__scrollCrtContent) {
            (window as any).__scrollCrtContent('up');
            setOutput('Buffer scrolled PAGE UP [▲].');
          }
          break;

        case 'pgdn':
        case 'pagedown':
        case 'page-down':
        case 'down':
          if ((window as any).__scrollCrtContent) {
            (window as any).__scrollCrtContent('down');
            setOutput('Buffer scrolled PAGE DOWN [▼].');
          }
          break;

        case 'top':
        case 'home':
          if ((window as any).__scrollCrtContent) {
            (window as any).__scrollCrtContent('top');
            setOutput('Buffer scrolled to TOP [⤒].');
          }
          break;

        case 'bottom':
        case 'end':
          if ((window as any).__scrollCrtContent) {
            (window as any).__scrollCrtContent('bottom');
            setOutput('Buffer scrolled to BOTTOM [⤓].');
          }
          break;

        default:
          setOutput(`bash: ${cmd}: command not found. Type 'help' or press [F1].`, true);
          break;
      }
    }

    form.onsubmit = (e) => {
      e.preventDefault();
      const val = input.value;
      input.value = '';
      execute(val);
    };

    // Keyboard History & Interception
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const val = input.value;
        input.value = '';
        execute(val);
        return;
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (historyIdx > 0) {
          historyIdx--;
          input.value = history[historyIdx] || '';
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIdx < history.length - 1) {
          historyIdx++;
          input.value = history[historyIdx] || '';
        } else {
          historyIdx = history.length;
          input.value = '';
        }
      }
    });

    if (refreshBtn) {
      refreshBtn.onclick = () => triggerScreenRefresh();
    }

    fnButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cmd = btn.getAttribute('data-cmd');
        if (cmd) execute(cmd);
      });
    });

    // Global DOS Function Keys interceptor
    document.addEventListener('keydown', (e) => {
      if (e.key === 'F5') {
        e.preventDefault();
        triggerScreenRefresh();
        return;
      }
      if (e.key === 'F1') {
        e.preventDefault();
        execute('help');
        return;
      }
      if (e.key === 'F2') {
        e.preventDefault();
        navigate('/projects');
        return;
      }
      if (e.key === 'F3') {
        e.preventDefault();
        navigate('/cli-tools');
        return;
      }
      if (e.key === 'F4') {
        e.preventDefault();
        execute('clear');
        return;
      }
      if (e.key === 'F6') {
        e.preventDefault();
        execute('pgup');
        return;
      }
      if (e.key === 'F7') {
        e.preventDefault();
        execute('pgdn');
        return;
      }
      if (e.key === 'F8') {
        e.preventDefault();
        execute('sound');
        return;
      }
      if (e.key === 'F10') {
        e.preventDefault();
        execute('reboot');
        return;
      }
    });
  }

  // Initialize on load and Astro page transitions
  setupBottomCli();
  document.addEventListener('astro:page-load', setupBottomCli);
</script>

---
interface Props {
  activeTab?: string;
}

const { activeTab = 'about' } = Astro.props;

const navItems = [
  { id: 'about', label: '[1:ABOUT]', href: '/' },
  { id: 'projects', label: '[2:PROJECTS]', href: '/projects' },
  { id: 'cli_tools', label: '[3:CLI_TOOLS]', href: '/cli-tools' },
];
---

<header class="border-b border-[#3f3f46] pb-1.5 mb-2 select-none" aria-label="Workstation DOS Menu Bar">
  <!-- Ultra-Compact Authentic 90s DOS/Linux Menu Bar -->
  <div class="flex items-center justify-between text-xs font-mono bg-black/90 px-2 py-1 border border-[#3f3f46] gap-2">
    <!-- Left: Identity & DOS Menu Tabs -->
    <div class="flex items-center gap-1.5 sm:gap-3 overflow-x-auto">
      <h1 class="text-[#fbbf24] font-bold text-[11px] sm:text-xs whitespace-nowrap m-0 inline">
        FABIAN ALTHAUS (el-j) // EL-J BIOS v2.084 //
      </h1>
      <nav class="flex items-center gap-1" aria-label="Main Navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`hud-nav-tab px-2 py-0.5 text-[10px] sm:text-xs font-bold transition-none whitespace-nowrap ${
              activeTab === item.id
                ? 'active bg-[#fbbf24] text-black'
                : 'text-[#d4d4d8] hover:bg-[#27272a] hover:text-[#fbbf24]'
            }`}
            data-tab={item.id}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Right: Real DOS/Linux Telemetry -->
    <div class="flex items-center gap-2 sm:gap-3 text-[10px] sm:text-[11px] text-[#71717a] font-mono shrink-0">
      <span class="hidden md:inline">CPU: <strong class="text-[#d4d4d8]">486-DX@66</strong></span>
      <span class="hidden sm:inline">RAM: <strong class="text-[#fbbf24]">16MB</strong></span>
      <span>SYS: <strong class="text-[#22c55e]">200 OK</strong></span>
      <span class="text-[#38bdf8] font-bold px-1 bg-[#18181b] border border-[#3f3f46]">TTY1</span>
    </div>
  </div>
</header>

<script>
  import { navigate } from 'astro:transitions/client';

  // Global Keyboard Navigation (1, 2, 3, ~)
  function setupKeyboardNav() {
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA') return;

      if (e.key === '`' || e.key === '~') {
        e.preventDefault();
        const termInput = (document.getElementById('bottom-cli-input') || document.getElementById('terminal-input')) as HTMLInputElement | null;
        if (termInput) {
          termInput.focus();
        }
        return;
      }

      if (e.key === '1') navigate('/');
      if (e.key === '2') navigate('/projects');
      if (e.key === '3') navigate('/cli-tools');
    });
  }

  setupKeyboardNav();
</script>

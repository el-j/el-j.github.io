---
// TokenAstVisualizer.astro
---

<div class="terminal-card text-xs flex flex-col h-full min-h-0 flex-1 border border-[#3f3f46] bg-black p-2.5" id="ast-visualizer-card">
  <!-- Title Bar -->
  <div class="terminal-header text-[#d4d4d8] border-b border-[#27272a] pb-1 mb-2">
    <div class="flex items-center gap-1.5 font-bold">
      <span class="text-[10px] text-[#fbbf24]">[AST]</span>
      <span class="text-[#ffffff]">TOKEN_SPECS &rarr; COMPILER_AST</span>
    </div>
    <div class="text-[10px] text-[#71717a] font-mono">
      <span>FIGMA_VARS &hArr; TS_NODES</span>
    </div>
  </div>

  <!-- Interactive Vector Graphic Area -->
  <div class="flex-1 relative flex flex-col justify-between p-1 font-mono">
    <div class="grid grid-cols-12 gap-2 items-center">
      <!-- Left: Token Specs -->
      <div class="col-span-5 border border-[#3f3f46] p-2 bg-black">
        <div class="text-[10px] font-bold text-[#fbbf24] mb-1 flex items-center justify-between">
          <span>token specs</span>
          <span class="text-[9px] text-[#71717a]">W3C</span>
        </div>

        <div class="space-y-1 text-[10px]" id="tokens-list">
          <div class="token-item cursor-pointer p-1 hover:bg-[#27272a] border border-transparent hover:border-[#fbbf24] transition-none active" data-token="color" data-val="#fbbf24">
            <span class="text-[#71717a]">--bios-gold:</span>
            <span class="text-[#fbbf24] font-bold">#fbbf24</span>
          </div>
          <div class="token-item cursor-pointer p-1 hover:bg-[#27272a] border border-transparent hover:border-[#fbbf24] transition-none" data-token="radius" data-val="0px">
            <span class="text-[#71717a]">--border-rad:</span>
            <span class="text-[#38bdf8] font-bold">0px</span>
          </div>
          <div class="token-item cursor-pointer p-1 hover:bg-[#27272a] border border-transparent hover:border-[#fbbf24] transition-none" data-token="scanline" data-val="0.18">
            <span class="text-[#71717a]">--scanline-op:</span>
            <span class="text-[#22c55e] font-bold">0.18</span>
          </div>
        </div>
      </div>

      <!-- Center: Transform Arrow / Impact -->
      <div class="col-span-2 flex flex-col items-center justify-center text-center">
        <span class="text-xs text-[#71717a] font-mono">&rarr;</span>
        <div class="w-6 h-6 my-1 flex items-center justify-center text-[#fbbf24] text-sm animate-pulse">
          &#10038;
        </div>
        <span class="text-[8px] text-[#71717a] uppercase">Compiler</span>
      </div>

      <!-- Right: AST Tree Graph -->
      <div class="col-span-5 border border-[#3f3f46] p-2 bg-black">
        <div class="text-[10px] font-bold text-[#fbbf24] mb-1 flex items-center justify-between">
          <span>AST Node</span>
          <span class="text-[9px] text-[#71717a]">TypeScript</span>
        </div>

        <div class="space-y-1 font-mono text-[10px]" id="ast-inspector-box">
          <div class="text-[#d4d4d8] p-1 bg-[#09090b] border border-[#27272a] leading-tight">
            <div class="text-[9px] text-[#71717a]" id="ast-node-type">TypeAliasDeclaration</div>
            <div class="text-[#ffffff] font-bold truncate" id="ast-node-ident">Identifier("BiosGoldToken")</div>
            <div class="text-[9px] text-[#38bdf8]" id="ast-node-val">LiteralType("#fbbf24")</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Inspect Info Banner -->
    <div class="my-1.5 p-1.5 bg-[#09090b] border border-[#3f3f46] text-[10px] text-[#d4d4d8]">
      <span class="text-[#71717a]">// COMPILER STATUS:</span>
      <span id="compiler-msg">AST generation synchronized with Figma tokens (0ms latency).</span>
    </div>

    <!-- Tech Badges -->
    <div class="pt-1.5 border-t border-[#27272a] flex flex-wrap items-center justify-between gap-2 text-[10px] font-mono">
      <div class="flex items-center gap-1 font-bold">
        <span class="text-[#71717a]">::</span>
        <span class="text-[#ffffff]">react</span>
      </div>
      <div class="flex items-center gap-1 font-bold">
        <span class="text-[#71717a]">::</span>
        <span class="text-[#ffffff]">vue</span>
      </div>
      <div class="flex items-center gap-1 font-bold">
        <span class="text-[#71717a]">::</span>
        <span class="text-[#ffffff]">figma</span>
      </div>
      <div class="flex items-center gap-1 font-bold">
        <span class="text-[#71717a]">::</span>
        <span class="text-[#ffffff]">linux</span>
      </div>
    </div>
  </div>
</div>

<script>
  // Interactive Token -> AST Inspector
  const tokenItems = document.querySelectorAll<HTMLElement>('.token-item');
  const astNodeType = document.getElementById('ast-node-type');
  const astNodeIdent = document.getElementById('ast-node-ident');
  const astNodeVal = document.getElementById('ast-node-val');
  const compilerMsg = document.getElementById('compiler-msg');

  const AST_MAP: Record<string, { type: string; ident: string; val: string; desc: string }> = {
    color: {
      type: 'VariableDeclaration: const',
      ident: 'Identifier("PHOSPHOR_COLOR")',
      val: 'StringLiteral("#ff9d00")',
      desc: 'W3C Color token resolved to AST StringLiteral with WCAG 7.2:1 contrast ratio.'
    },
    radius: {
      type: 'PropertyAssignment',
      ident: 'Identifier("borderRadius")',
      val: 'NumericLiteral(18) + Unit("px")',
      desc: 'Bezel curvature token emitted into CSS AST ruleset.'
    },
    scanline: {
      type: 'CustomPropertyDeclaration',
      ident: 'Identifier("--scanline-op")',
      val: 'FloatLiteral(0.18)',
      desc: 'Raster scanline shader coefficient compiled into CSS variables.'
    }
  };

  tokenItems.forEach((item) => {
    item.addEventListener('click', () => {
      tokenItems.forEach((t) => t.classList.remove('bg-[var(--crt-phosphor)]/20', 'border-[var(--crt-border)]'));
      item.classList.add('bg-[var(--crt-phosphor)]/20', 'border-[var(--crt-border)]');

      const tokenKey = item.getAttribute('data-token') || 'color';
      const data = AST_MAP[tokenKey];
      if (data && astNodeType && astNodeIdent && astNodeVal && compilerMsg) {
        astNodeType.textContent = data.type;
        astNodeIdent.textContent = data.ident;
        astNodeVal.textContent = data.val;
        compilerMsg.textContent = data.desc;
      }

      if ((window as any).__playClickSound) {
        (window as any).__playClickSound();
      }
    });
  });
</script>

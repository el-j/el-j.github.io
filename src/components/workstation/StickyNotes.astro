---
// StickyNotes.astro
---

<div class="sticky-notes-layer pointer-events-none absolute inset-0 overflow-visible hidden lg:block" aria-hidden="true">
  <!-- Note 1: Top Left -->
  <div
    class="sticky-note note-yellow pointer-events-auto -top-5 -left-6 rotate-[-5deg]"
    id="note-c-statement"
    title="Click to drag note"
  >
    <div class="text-[9px] uppercase tracking-wider opacity-75 font-bold mb-1">&lt;bcddtda.c&gt;</div>
    <div class="font-mono text-[10px] leading-snug">
      int // statement<br/>
      ig(i) &#123;<br/>
      &nbsp;&nbsp;[tang(4as)-r]<br/>
      &#125;;<br/>
      return (scalar);
    </div>
  </div>

  <!-- Note 2: Top Right -->
  <div
    class="sticky-note note-yellow pointer-events-auto -top-7 -right-7 rotate-[4deg]"
    id="note-ast-types"
    title="Click to drag note"
  >
    <div class="text-[9px] uppercase tracking-wider opacity-75 font-bold mb-1">&lt;token_ast.ts&gt;</div>
    <div class="font-mono text-[10px] leading-snug">
      if (in &#123; [rrow ("..)]c" &#125;) &#123;<br/>
      &nbsp;&nbsp;type AST = TokenNode;<br/>
      &nbsp;&nbsp;return (scalar);<br/>
      &#125;
    </div>
  </div>

  <!-- Note 3: Bottom Right -->
  <div
    class="sticky-note note-pink pointer-events-auto -bottom-8 -right-6 rotate-[-3deg]"
    id="note-boden-code"
    title="Click to drag note"
  >
    <div class="text-[9px] uppercase tracking-wider opacity-75 font-bold mb-1">&lt;boden code&gt;</div>
    <div class="font-mono text-[10px] leading-snug">
      &lt;Ald latstr="" /&gt;<br/>
      &lt;/a_scrap&gt;<br/>
      :: s / 6a<br/>
      <span class="font-bold underline text-red-950">linux &gt; all</span>
    </div>
  </div>
</div>

<script>
  // Simple draggable behavior for sticky notes
  const notes = document.querySelectorAll<HTMLElement>('.sticky-note');
  notes.forEach((note) => {
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let initialLeft = 0;
    let initialTop = 0;

    note.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      const rect = note.getBoundingClientRect();
      const parentRect = note.offsetParent ? (note.offsetParent as HTMLElement).getBoundingClientRect() : { left: 0, top: 0 };
      initialLeft = rect.left - parentRect.left;
      initialTop = rect.top - parentRect.top;
      note.style.zIndex = '999';
      note.style.cursor = 'grabbing';
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      note.style.left = `${initialLeft + dx}px`;
      note.style.top = `${initialTop + dy}px`;
      note.style.bottom = 'auto';
      note.style.right = 'auto';
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        note.style.cursor = 'grab';
      }
    });
  });
</script>

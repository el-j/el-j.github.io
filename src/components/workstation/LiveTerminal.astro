---
// LiveTerminal.astro - Interactive Command Line REPL for Fabian Althaus Workstation
---

<div class="terminal-card text-xs flex flex-col h-full min-h-0 flex-1" id="terminal-island">
  <!-- Terminal Title Bar -->
  <div class="terminal-header text-[var(--crt-phosphor)]">
    <div class="flex items-center gap-2">
      <span class="text-[10px] text-[var(--crt-phosphor-bright)]">[DOS_TTY1]</span>
      <span class="font-bold">COMMAND.COM // DEBUG_ENV</span>
    </div>
    <div class="flex items-center gap-2 text-[10px] text-[var(--crt-phosphor-dim)] font-mono">
      <button type="button" class="hover:text-[var(--crt-phosphor)] cursor-pointer" id="term-btn-min" title="Minimize">[ _ ]</button>
      <button type="button" class="hover:text-[var(--crt-phosphor)] cursor-pointer" id="term-btn-max" title="Maximize">[ &square; ]</button>
      <button type="button" class="hover:text-red-400 cursor-pointer" id="term-btn-clear" title="Clear">[ x ]</button>
    </div>
  </div>

  <!-- Terminal Output Buffer -->
  <div
    class="flex-1 overflow-y-auto space-y-1.5 font-mono text-[11px] leading-relaxed p-1 text-[var(--crt-phosphor)] scrollbar-thin"
    id="terminal-output"
  >
    <div class="text-[var(--crt-phosphor-dim)]">
      Linux el-j-station 6.12.9-arch1-1 #1 SMP PREEMPT_DYNAMIC x86_64 GNU/Linux
    </div>
    <div class="text-[var(--crt-phosphor-dim)]">
      Fabian Althaus // Concept, Design, Implementation. Type <span class="text-[var(--crt-phosphor-bright)] font-bold">help</span> for commands.
    </div>
    <div class="border-b border-dashed border-[var(--crt-border-dim)] my-1.5 opacity-50"></div>
  </div>

  <!-- Terminal Input Prompt -->
  <form class="flex items-center gap-1.5 pt-2 border-t border-[#3f3f46] font-mono text-[11px]" id="terminal-form">
    <span class="text-[#fbbf24] font-bold whitespace-nowrap">A:\&gt;</span>
    <input
      type="text"
      id="terminal-input"
      class="flex-1 bg-transparent border-none outline-none text-[var(--crt-phosphor)] font-mono text-[11px] p-0 m-0 focus:ring-0"
      autocomplete="off"
      spellcheck="false"
      placeholder=""
    />
    <span class="cursor-blink"></span>
  </form>
</div>

<script>
  function setupLiveTerminal() {
    const output = document.getElementById('terminal-output');
    const form = document.getElementById('terminal-form');
    const input = document.getElementById('terminal-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('term-btn-clear');

    if (!form || !input || !output) return;

    const commandHistory: string[] = [];
    let historyIdx = -1;

    const COMMANDS: Record<string, (args: string[]) => string> = {
      help: () => `AVAILABLE WORKSTATION COMMANDS:
  help              - Display this list of commands
  uname -a          - Print system & kernel architecture
  cat about.md      - Display bio & engineering philosophy
  ls projects       - List Fabian Althaus real flagship projects
  cat run-zero      - Inspect RunZero dual-engine runner fleet
  cat gst           - Inspect @el-j/google-sheet-translations
  cat rex-at        - Inspect REX-AT industrial machine controls
  cat fritzing      - Inspect Fritzing open-source hardware EDA
  ls cli_tools      - List developer tools & CLI packages
  git log --graph   - Render ASCII branch topology
  contact           - Display communication channels
  synth             - Engage + SYNTH_T1 + pocket synthesizer
  reboot            - Trigger warm BIOS POST & Drive A: boot
  cowsay <text>     - The quintessential Unix wisdom
  clear             - Clear terminal buffer`,

      refresh: () => {
        if ((window as any).__refreshCrtScreen) {
          (window as any).__refreshCrtScreen();
        }
        return `[OK] CRT display refreshed & cathode ray degaussed.`;
      },

      reboot: () => {
        sessionStorage.removeItem('crt-booted');
        if ((window as any).__triggerBiosBoot) {
          (window as any).__triggerBiosBoot();
        } else {
          window.location.reload();
        }
        return `[SYSTEM] Resetting CPU registers. Initiating warm hardware reboot...`;
      },

      synth: () => {
        const synthBtn = document.getElementById('btn-toggle-synth');
        if (synthBtn) synthBtn.click();
        return `[AUDIO] Pocket Synthesizer (+ SYNTH_T1 +) engaged. Use keys [A..K] or mouse to trigger notes.`;
      },

      'uname -a': () => `Linux el-j-station 6.12.9-arch1-1 #1 SMP PREEMPT_DYNAMIC x86_64 GNU/Linux`,
      uname: () => `Linux`,

      'cat about.md': () => `FABIAN ALTHAUS (el-j)
=================================================================
Profile: Software engineer, designer and professional consultant
Focus:   Digital and analogue interfaces, apps and websites.
Motto:   Concept, design, implementation.
Website: https://fabianalthaus.de/en/
GitHub:  https://github.com/el-j`,

      'ls projects': () => `REAL PORTFOLIO PROJECTS:
  [1] run-zero      - Dual-Engine Autoscaling GitHub Actions Runner Fleet
  [2] gst           - Google Sheet Translations (@el-j/google-sheet-translations)
  [3] rex-at        - Industrial Machine Web-UIs & Production Line Controls
  [4] fritzing      - Open-Source Electronics EDA Software & Parts Editor
  [5] enginsight    - Modular SIEM Cybersecurity Platform
  [6] domedrum      - Open Source Physical MIDI Controller
  [7] e-cube        - Gel Electrophoresis Laboratory Instrument
  [8] ktm-motohall  - Museum IoT Sensor Monitors & Telemetry
Type 'cat <project-name>' to inspect or 'open projects' to view all.`,

      'cat run-zero': () => `RUNZERO // DUAL-ENGINE AUTOSCALING RUNNER FLEET
Toolset: Docker, OrbStack, GitHub Actions, Linux, systemd, Verdaccio, Athens, Astro
Summary: Autoscaling self-hosted GitHub Actions runner fleet with dual backends:
         Docker containers for lightweight tasks + OrbStack VMs for privileged systemd/DinD.
         Integrated caching proxies reduce CI execution times by up to 8x.`,

      'cat gst': () => `GOOGLE SHEET TRANSLATIONS (@el-j/google-sheet-translations)
Toolset: TypeScript, Node.js, Google Sheets API, GitHub Actions, NPM
Summary: Open-source NPM package and GitHub Action syncing spreadsheet rows
         directly to type-safe JSON/TS locale dictionaries with validation.`,

      'cat rex-at': () => `REX-AT // INDUSTRIAL MACHINERY CONTROLS & WEB-UIS
Toolset: Industrial Web-UI, TypeScript, SCADA, Vue, WebSockets, Embedded Linux
Summary: Rugged touchscreen control interfaces for machine operators and
         production telemetry in factory environments with zero data loss.`,

      'cat fritzing': () => `FRITZING // HARDWARE MADE SIMPLE
Toolset: Interaction Design, EDA Software, Parts Editor, C++, Figma
Summary: Interaction redesign for the globally recognized open-source
         electronics prototyping tool and Fritzing 2.0 UX architecture.`,

      'ls cli_tools': () => `DEVELOPER TOOLS & PACKAGES:
  [1] agency-agents-sdk       - Multi-agent swarm SDK & CLI (npm)
  [2] google-sheet-translations - Bidirectional Google Sheets i18n sync (npm)
  [3] run-zero                - Zero-cost local runner fleet (Go/Docker)
  [4] magic-agent-helix       - AI instruction generator (npm)
  [5] nexus-orchestrator      - Multi-model AI task orchestrator (Go/MCP)
  [6] ts2go                   - TypeScript-to-Go transpiler (Go)
  [7] nix-config-collector    - Declarative Nix config generator (Go)
  [8] direct-connector        - P2P tunnel & port forwarder (Go/Wails)
Type 'open cli' or 'open contrib' to inspect open-source releases & contributions.`,

      'git log --graph': () => `* 65d36e5 (HEAD -> feat/cli-tui-fullscreen-crt) feat: 90s dos text console & bios draw
* 1de3c49 docs: add roadmap and live github issues
* 7a8f092 feat(run-zero): hybrid auto-routing between docker & orbstack
* e901b22 feat(gst): publish @el-j/google-sheet-translations`,

      contact: () => `COMMUNICATION CHANNELS:
  Email:     info@fabianalthaus.de
  Portfolio: https://fabianalthaus.de/en/
  GitHub:    https://github.com/el-j`,

      clear: () => '',
      sudo: () => `[SECURITY ALERT] User 'el-j' is not in sudoers file. This incident has been logged.`,
      matrix: () => `1010010101010101010101010101010101010101010101010101
0101011010101010101010101010101010101010101010101010`,
    };

    function appendLine(html: string) {
      if (!output) return;
      const line = document.createElement('div');
      line.innerHTML = html;
      output.appendChild(line);
      output.scrollTop = output.scrollHeight;
    }

    function handleCommand(cmdRaw: string) {
      const raw = cmdRaw.trim();
      if (!raw) return;

      commandHistory.push(raw);
      historyIdx = commandHistory.length;

      appendLine(`<div class="text-[#ffffff]"><span class="text-[#fbbf24]">A:\\&gt;</span> ${escapeHtml(raw)}</div>`);

      const [cmd, ...args] = raw.split(' ');
      const lower = cmd.toLowerCase();

      if (lower === 'clear') {
        if (output) output.innerHTML = '';
        return;
      }

      if (lower === 'open') {
        const dest = args[0];
        if (dest === 'projects') window.location.href = '/projects';
        else if (dest === 'cli' || dest === 'cli_tools') window.location.href = '/cli-tools';
        else if (dest === 'about') window.location.href = '/';
        else appendLine(`<span class="text-red-400">Unknown destination: ${dest}. Try 'open projects', 'open cli'.</span>`);
        return;
      }

      if (lower === 'theme') {
        appendLine(`<span class="text-[#fbbf24]">Display locked to VGA Mode 3 text console (Award BIOS color profile).</span>`);
        return;
      }

      if (lower === 'cowsay') {
        const text = args.join(' ') || 'Hardware & Software: Concept, Design, Implementation.';
        const cow = `  < ${escapeHtml(text)} >
  ------------------------------------
         \\   ^__^
          \\  (oo)\\_______
             (__)\\       )\\/\\
                 ||----w |
                 ||     ||`;
        appendLine(`<pre class="text-[var(--crt-phosphor)] my-1 leading-none">${cow}</pre>`);
        return;
      }

      const handler = COMMANDS[raw] || COMMANDS[lower];
      if (handler) {
        appendLine(`<pre class="text-[var(--crt-phosphor)] font-mono whitespace-pre-wrap">${escapeHtml(handler(args))}</pre>`);
      } else {
        appendLine(`<span class="text-red-400">command not found: ${escapeHtml(raw)}. Type 'help' for available commands.</span>`);
      }

      if ((window as any).__playClickSound) {
        (window as any).__playClickSound();
      }
    }

    function escapeHtml(str: string): string {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    form.onsubmit = (e) => {
      e.preventDefault();
      const val = input.value;
      input.value = '';
      handleCommand(val);
    };

    input.onkeydown = (e) => {
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (historyIdx > 0) {
          historyIdx--;
          input.value = commandHistory[historyIdx] || '';
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIdx < commandHistory.length - 1) {
          historyIdx++;
          input.value = commandHistory[historyIdx] || '';
        } else {
          historyIdx = commandHistory.length;
          input.value = '';
        }
      } else if (e.key === 'Tab') {
        e.preventDefault();
        const current = input.value.trim().toLowerCase();
        const matches = Object.keys(COMMANDS).filter((c) => c.startsWith(current));
        if (matches.length === 1) {
          input.value = matches[0];
        } else if (matches.length > 1) {
          appendLine(`<span class="text-[var(--crt-phosphor-dim)]">${matches.join('  ')}</span>`);
        }
      }
    };

    if (clearBtn) {
      clearBtn.onclick = () => {
        output.innerHTML = '';
      };
    }
  }

  setupLiveTerminal();
  document.addEventListener('astro:page-load', setupLiveTerminal);
</script>

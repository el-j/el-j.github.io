---
// GrubMenu.astro - GRUB-style boot manager shown after POST. Picks GUI or text mode.
---

<div
  id="grub-overlay"
  class="fixed inset-0 z-[50] bg-black text-[#d4d4d8] font-mono text-xs sm:text-sm hidden flex-col items-center justify-center p-4 select-none"
  role="dialog"
  aria-label="Boot manager"
>
  <div class="w-full max-w-2xl">
    <div class="text-center mb-3">GNU GRUB  version 2.12</div>
    <ul id="grub-list" class="border border-[#d4d4d8] list-none m-0 p-1" role="listbox" aria-label="Boot entries">
      <li role="option" class="grub-entry px-3 py-1.5 cursor-pointer" data-mode="gui">el-j  (graphical interface)</li>
      <li role="option" class="grub-entry px-3 py-1.5 cursor-pointer" data-mode="text">el-j  (text console, shell only)</li>
    </ul>
    <div class="mt-3 text-[#a1a1aa] leading-relaxed">
      <div>Use the &uarr; and &darr; keys, or tap, to select an entry.</div>
      <div>Press enter to boot the selected entry.</div>
      <div id="grub-countdown" class="mt-2 text-[#fbbf24]"></div>
    </div>
  </div>
</div>

<style>
  .grub-entry.is-selected {
    background: #d4d4d8;
    color: #000;
  }
</style>

<script>
  const SECONDS = 5;
  type Mode = 'gui' | 'text';

  let selected = 0;
  let remaining = SECONDS;
  let timer: number | undefined;

  // Elements are looked up on every call because view transitions replace the DOM.
  const overlayEl = () => document.getElementById('grub-overlay');
  const entryEls = () => Array.from(document.querySelectorAll<HTMLElement>('.grub-entry'));

  function render() {
    entryEls().forEach((el, i) => {
      el.classList.toggle('is-selected', i === selected);
      el.setAttribute('aria-selected', String(i === selected));
    });
  }

  function stopTimer() {
    if (timer !== undefined) {
      window.clearInterval(timer);
      timer = undefined;
    }
    const c = document.getElementById('grub-countdown');
    if (c) c.textContent = '';
  }

  function showCountdown() {
    const c = document.getElementById('grub-countdown');
    if (c) c.textContent = `The highlighted entry will be executed automatically in ${remaining}s.`;
  }

  function boot() {
    const overlay = overlayEl();
    const mode = (entryEls()[selected]?.dataset.mode as Mode) || 'gui';
    sessionStorage.setItem('el-j-mode', mode);
    stopTimer();
    if (overlay) {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
      overlay.dataset.open = 'false';
    }
    window.dispatchEvent(new CustomEvent('el-j-mode-change', { detail: mode }));
  }

  function open() {
    const overlay = overlayEl();
    if (!overlay) return;
    stopTimer();
    selected = 0;
    remaining = SECONDS;
    render();
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    overlay.dataset.open = 'true';
    showCountdown();
    timer = window.setInterval(() => {
      remaining -= 1;
      if (remaining <= 0) boot();
      else showCountdown();
    }, 1000);
  }

  document.addEventListener('click', (e) => {
    const entry = (e.target as HTMLElement | null)?.closest('.grub-entry') as HTMLElement | null;
    if (!entry) return;
    selected = entryEls().indexOf(entry);
    render();
    boot();
  });

  window.addEventListener(
    'keydown',
    (e) => {
      if (overlayEl()?.dataset.open !== 'true') return;
      e.stopPropagation();
      stopTimer();
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const n = entryEls().length;
        selected = (selected + (e.key === 'ArrowDown' ? 1 : -1) + n) % n;
        render();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        boot();
      }
    },
    true,
  );

  window.addEventListener('crt-boot-complete', open);
</script>

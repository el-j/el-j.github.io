---
// BezelControls.astro
---

<div class="mt-4 pt-3 border-t border-[#353842] flex flex-wrap items-center justify-between gap-4 text-xs select-none">
  <!-- Left: Red Stencil Date Stamp -->
  <div class="flex items-center gap-3">
    <div class="bezel-screw" title="M4 Bezel Screw"></div>
    <div
      class="font-mono font-bold tracking-widest text-[#ff3333] text-sm uppercase px-2 py-0.5 bg-black/60 border border-[#ff3333]/40 rounded shadow-[0_0_8px_rgba(255,50,50,0.5)]"
      id="bezel-date-stamp"
    >
      OCT. 11 2026
    </div>
    <span class="text-[10px] text-[#787f91] hidden sm:inline font-mono">MODEL: CRT-2084-UX</span>
  </div>

  <!-- Center: Phosphor Theme Selector -->
  <div class="flex items-center gap-1.5 font-mono text-[11px] bg-black/40 p-1 rounded border border-[#3c414f]">
    <span class="text-[#787f91] px-1 text-[10px]">PHOSPHOR:</span>
    <button
      class="theme-btn px-2 py-0.5 rounded text-[10px] font-bold border border-[#ff9d00] text-[#ff9d00] bg-[#ff9d00]/10 hover:bg-[#ff9d00]/20 transition-all active:scale-95"
      data-set-theme="amber"
    >
      AMBER
    </button>
    <button
      class="theme-btn px-2 py-0.5 rounded text-[10px] font-bold border border-[#00ff66]/50 text-[#00ff66] bg-transparent hover:bg-[#00ff66]/10 transition-all active:scale-95"
      data-set-theme="green"
    >
      GREEN
    </button>
    <button
      class="theme-btn px-2 py-0.5 rounded text-[10px] font-bold border border-[#00e5ff]/50 text-[#00e5ff] bg-transparent hover:bg-[#00e5ff]/10 transition-all active:scale-95"
      data-set-theme="ice"
    >
      ICE
    </button>
    <button
      class="theme-btn px-2 py-0.5 rounded text-[10px] font-bold border border-[#d6d3d1]/50 text-[#e7e5e4] bg-transparent hover:bg-white/10 transition-all active:scale-95"
      data-set-theme="paper"
    >
      PAPER
    </button>
  </div>

  <!-- Right: Hardware Toggles & Power LED -->
  <div class="flex items-center gap-4 font-mono text-[11px] text-[#9ba1b0]">
    <!-- Scanlines Toggle -->
    <label class="flex items-center gap-1.5 cursor-pointer hover:text-white transition-colors" title="Toggle CRT scanline raster">
      <span class="text-[10px]">SCANLINES</span>
      <input type="checkbox" id="toggle-scanlines" checked class="sr-only" />
      <span class="toggle-slider w-7 h-3.5 bg-[#17181b] border border-[#4a4e5a] rounded-full inline-block relative after:content-[''] after:absolute after:top-[1px] after:left-[1px] after:w-2.5 after:h-2.5 after:bg-[#ff9d00] after:rounded-full after:transition-transform"></span>
    </label>

    <!-- Audio SFX Toggle -->
    <label class="flex items-center gap-1.5 cursor-pointer hover:text-white transition-colors" title="Toggle mechanical click sound FX">
      <span class="text-[10px]">SOUND_FX</span>
      <input type="checkbox" id="toggle-sound-fx" class="sr-only" />
      <span class="toggle-slider w-7 h-3.5 bg-[#17181b] border border-[#4a4e5a] rounded-full inline-block relative after:content-[''] after:absolute after:top-[1px] after:left-[1px] after:w-2.5 after:h-2.5 after:bg-[#5c6370] after:rounded-full after:transition-transform"></span>
    </label>

    <!-- Power Indicator LED -->
    <div class="flex items-center gap-1.5 pl-2 border-l border-[#3a3e4b]">
      <span class="w-2.5 h-2.5 rounded-full bg-[#00ff66] shadow-[0_0_8px_#00ff66]"></span>
      <span class="text-[10px] font-bold text-[#abb2bf]">PWR</span>
    </div>

    <div class="bezel-screw" title="M4 Bezel Screw"></div>
  </div>
</div>

<script>
  // Phosphor Theme Switcher logic
  const themeButtons = document.querySelectorAll<HTMLButtonElement>('.theme-btn');
  const savedTheme = localStorage.getItem('crt-theme') || 'amber';
  document.documentElement.setAttribute('data-theme', savedTheme);

  themeButtons.forEach((btn) => {
    const theme = btn.getAttribute('data-set-theme');
    if (theme === savedTheme) {
      btn.classList.add('glow-text');
    }

    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-set-theme') || 'amber';
      document.documentElement.setAttribute('data-theme', selected);
      localStorage.setItem('crt-theme', selected);

      // Play audio click if sound engine initialized
      if ((window as any).__playClickSound) {
        (window as any).__playClickSound();
      }
    });
  });

  // Scanlines toggle
  const scanlinesToggle = document.getElementById('toggle-scanlines') as HTMLInputElement | null;
  if (scanlinesToggle) {
    scanlinesToggle.addEventListener('change', () => {
      document.documentElement.style.setProperty(
        '--scanline-opacity',
        scanlinesToggle.checked ? '0.18' : '0'
      );
    });
  }

  // Audio SFX toggle
  const soundToggle = document.getElementById('toggle-sound-fx') as HTMLInputElement | null;
  if (soundToggle) {
    soundToggle.addEventListener('change', () => {
      (window as any).__soundEnabled = soundToggle.checked;
    });
  }
</script>
